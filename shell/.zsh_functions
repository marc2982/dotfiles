# ==============================================================================
# Shell functions (sourced from .zshrc)
# ==============================================================================
# Interactive-only helpers live here to keep .zshrc readable. Functions (not
# ~/.local/bin scripts) because these are human-typed and/or need shell state
# (e.g. mkcd's cd must persist in the current shell).

mkcd() {
    mkdir -p "$1" && cd "$1"
}

memhogs() {
  free -h | awk '/^Mem:/{printf "RAM:  %s used / %s total (%s available, %s free + %s buff/cache)\n",$3,$2,$7,$4,$6} /^Swap:/{printf "Swap: %s used / %s total (%s free)\n",$3,$2,$4}'
  echo ""
  ps aux --sort=-%mem | awk 'NR==1{printf "%-7s %-9s %-7s %s\n","MEM%","RSS","USER","COMMAND"} NR>1&&NR<=6{rss=$6; if(rss>=1048576){h=sprintf("%.1fG",rss/1048576)}else if(rss>=1024){h=sprintf("%.0fM",rss/1024)}else{h=sprintf("%dK",rss)}; printf "%-7s %-9s %-7s %s\n",$4"%",h,$1,$11}'
}

cpuhogs() {
  if [[ "$1" == (-c|--capture) ]]; then
    _cpuhogs_capture "${2:-60}"
    return
  fi
  local secs="${1:-5}"
  printf "Polling CPU for %ss..." "$secs" >&2
  # top's 2nd sample = CPU over the interval, so the delay between the two samples
  # IS the polling window. Averaging over ~5s smooths out momentary spikes. One
  # run gives us both the %Cpu(s) summary (for the IO verdict) and the process rows.
  local out
  out="$(top -bn2 -d "$secs" -w 512 -o %CPU | awk '/^ *PID/{p++} p>=1')"
  printf "\r\033[K" >&2   # erase the polling line

  # Load line + CPU-bound vs IO-bound verdict from the 2nd sample's %Cpu(s) row
  # (wa = time blocked on IO, id = idle). High load + high wa = disk-bound, not CPU.
  echo "$out" | awk -v n="$(nproc)" '
    /^%Cpu/ { for(i=1;i<=NF;i++){ if($i~/^wa,?$/)wa=$(i-1); if($i~/^id,?$/)id=$(i-1) } }
    END {
      "cut -d\" \" -f1-3 /proc/loadavg" | getline la
      split(la, L, " ")
      verdict = (wa+0 >= 15) ? sprintf("IO-bound (iowait %.0f%%)", wa) : \
                (id+0 <= 20) ? sprintf("CPU-bound (idle %.0f%%)", id)  : \
                                sprintf("relaxed (idle %.0f%%)", id)
      printf "Load: %s %s %s (1/5/15 min, %d cores) \xc2\xb7 %s\n", L[1],L[2],L[3],n,verdict
    }'
  echo ""

  # Process rows: capture PID (col 1) to look up live thread count from /proc.
  echo "$out" | awk '
    /^ *PID/ { p++ }
    p==2 && /^ *PID/ { printf "%-7s %-7s %-5s %-9s %s\n","CPU%","MEM%","THR","USER","COMMAND"; next }
    p==2 && seen<5 {
      thr="?"; f="/proc/"$1"/status"
      while ((getline line < f) > 0) if (line ~ /^Threads:/) { split(line,t," "); thr=t[2]; break }
      close(f)
      printf "%-7s %-7s %-5s %-9s %s\n",$9"%",$10"%",thr,$2,$12; seen++
    }'
}

# cpuhogs --capture [secs]: sample /proc every second for a window (Ctrl-C ends early) and
# total CPU per command. Catches bursts of short-lived processes (builds, hooks, test runs)
# that a one-shot cpuhogs misses. Processes that live and die between samples are never seen,
# but their CPU lands in the parent's cutime/cstime when reaped, so it's billed to the parent
# as "<parent> (children)". Seen-then-exited children are subtracted to avoid double counting.
_cpuhogs_capture() {
  emulate -L zsh
  setopt localtraps
  zmodload zsh/datetime zsh/zselect
  local secs="$1" tmp stop= i sample
  tmp="$(mktemp)"
  trap 'stop=1' INT

  for (( i = 0; i <= secs && ! stop; i++ )); do
    printf "\rCapturing %ds / %ds (Ctrl-C to stop early)..." "$i" "$secs" >&2
    # One line per process: pid:starttime ppid self_ticks reaped_child_ticks comm.
    # starttime in the key keeps a recycled PID from looking like the same process.
    sample="$(awk -v ts="$(strftime %T $EPOCHSECONDS)" '
      BEGIN {
        getline up < "/proc/uptime"; split(up, U, " ")
        getline la < "/proc/loadavg"; split(la, L, " ")
        getline st < "/proc/stat"; split(st, C, " ")
        for (j = 2; j <= 9; j++) tot += C[j]
        print "S", U[1], L[1], ts, tot, C[5] + C[6]
        me = PROCINFO["pid"]
        # getline, not awk file args: a process exiting mid-read is a fatal error for those.
        for (a = 1; a < ARGC; a++) {
          line = ""; ok = (getline line < ARGV[a]) > 0; close(ARGV[a])
          if (!ok) continue
          split(line, p, " "); if (p[1] == me) continue
          o = index(line, "("); r = match(line, /\)[^)]*$/)
          split(substr(line, r + 2), f, " ")
          print p[1] ":" f[20], f[2], f[12] + f[13], f[14] + f[15], substr(line, o + 1, r - o - 1)
        }
        exit
      }' /proc/[0-9]*/stat 2>/dev/null)"
    [[ -z "$stop" ]] && print -r -- "$sample" >> "$tmp"
    (( i < secs && ! stop )) && zselect -t 100
  done
  printf "\r\033[K" >&2

  awk -v hz="$(getconf CLK_TCK)" -v ncpu="$(nproc)" -v me="$$" '
    function byval(i1, v1, i2, v2) { return v2 - v1 }
    function flush(   k, kp, c, d, dc, dt, pct, busy, gone, iv) {
      if (!have) return
      for (k in cself) if (!(k in seen)) { seen[k] = 1; nprocs[ccomm[k]]++ }
      if (nprev) {
        dt = t - pt; if (dt <= 0) dt = 1
        busy = (tot > ptot) ? 100 * (1 - (idle - pidle) / (tot - ptot)) : 0
        busysum += busy; nint++
        if (busy > pkbusy) { pkbusy = busy; pkts = ts }
        for (k in pself) if (!(k in cself)) gone[ppar[k]] += pself[k] + pchild[k]
        for (k in cself) {
          split(k, kp, ":"); c = ccomm[k]
          if (k in pself)            { d = cself[k] - pself[k]; dc = cchild[k] - pchild[k] }
          else if (kp[2] >= pt * hz) { d = cself[k];            dc = cchild[k] }
          else continue  # predates the last sample but was missed by it: no baseline yet
          dc -= gone[kp[1]]
          if (d > 0) iv[c] += d
          if (dc > 0 && kp[1] != me) iv[c " (children)"] += dc
        }
        for (c in iv) {
          used[c] += iv[c]
          pct = 100 * iv[c] / (dt * hz); if (pct > peak[c]) peak[c] = pct
        }
        win += dt
      }
      delete pself; delete pchild; delete ppar
      for (k in cself) { pself[k] = cself[k]; pchild[k] = cchild[k]; ppar[k] = cpar[k] }
      delete cself; delete cchild; delete cpar
      pt = t; ptot = tot; pidle = idle; nprev = 1
    }
    $1 == "S" {
      flush(); have = 1
      t = $2; ts = $4; tot = $5; idle = $6
      if ($3 + 0 > pkload) pkload = $3 + 0
      next
    }
    {
      k = $1; cpar[k] = $2; cself[k] = $3; cchild[k] = $4
      c = $0; sub(/^([^ ]+ ){4}/, "", c); ccomm[k] = c
    }
    END {
      flush()
      if (!win) { print "No samples captured."; exit }
      printf "Captured %.0fs \xc2\xb7 CPU busy avg %.0f%%, peak %.0f%% at %s \xc2\xb7 load peak %.2f (%d cores)\n\n", \
        win, busysum / nint, pkbusy, pkts, pkload, ncpu
      printf "%-7s %-7s %-6s %s\n", "AVG%", "PEAK%", "PROCS", "COMMAND"
      PROCINFO["sorted_in"] = "byval"
      for (c in used) {
        if (++n > 8) break
        printf "%-7s %-7s %-6s %s\n", sprintf("%.0f%%", 100 * used[c] / (win * hz)), \
          sprintf("%.0f%%", peak[c]), (c ~ / \(children\)$/ ? "-" : nprocs[c]), c
      }
      print "\n100% = one core. (children) = CPU of processes that exited unseen, billed to the parent."
    }' "$tmp"
  rm -f "$tmp"
}

# --- Dotfiles management ---

dotfiles-sync() {
    (
        cd "$DOTFILES_DIR" || return 1
        git add -A
        if git commit -m "Update dotfiles $(date +%Y-%m-%d)"; then
            git push
        else
            echo "No changes to commit"
        fi
    )
}

dotfiles-status() {
    (cd "$DOTFILES_DIR" && git status)
}

dotfiles-diff() {
    (cd "$DOTFILES_DIR" && git diff)
}

# --- Git helpers ---

# Helper: outputs "short_hash|full_hash|commit_msg|file" per dirty file
# Groups: branch-local commits, UPSTREAM, or NEW
_git-last-touch-data() {
    local upstream_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/@@')
    if [ -z "$upstream_branch" ]; then
        upstream_branch="origin/main"
    fi

    local branch_commits=$(git log --pretty=format:"%H" $upstream_branch..HEAD 2>/dev/null)

    git status --porcelain | while IFS= read -r line; do
        file="${line:3}"
        commit_hash=$(git log -1 --pretty=format:"%h" -- "$file" 2>/dev/null)
        commit_hash_full=$(git log -1 --pretty=format:"%H" -- "$file" 2>/dev/null)

        if [ -n "$commit_hash" ]; then
            if echo "$branch_commits" | grep -q "^$commit_hash_full$"; then
                commit_msg=$(git log -1 --pretty=format:"%h %s" "$commit_hash")
                echo "$commit_hash|$commit_hash_full|$commit_msg|$file"
            else
                commit_msg=$(git log -1 --pretty=format:"%h %s" "$commit_hash")
                echo "UPSTREAM|UPSTREAM|⚠️  $commit_msg (UPSTREAM - do not amend)|$file"
            fi
        else
            echo "NEW|NEW|(new file)|$file"
        fi
    done | sort
}

# Show which commit last touched each dirty file (grouped by commit)
# Only shows commits on current branch (safe to amend)
git-last-touch() {
    echo "Dirty files grouped by last commit (current branch only):"
    echo "=========================================================="

    _git-last-touch-data | awk -F'|' '
        BEGIN { prev_commit = "" }
        {
            commit = $1
            commit_msg = $3
            file = $4

            if (commit != prev_commit) {
                if (prev_commit != "") print ""
                print "\n" commit_msg ":"
                prev_commit = commit
            }
            print "  • " file
        }
    '
}

# Like git-last-touch, but creates fixup! commits for each group
git-last-touch-fixup() {
    echo "Dirty files grouped by last commit (current branch only):"
    echo "=========================================================="

    local data=$(_git-last-touch-data)

    # Display the same output as git-last-touch
    echo "$data" | awk -F'|' '
        BEGIN { prev_commit = "" }
        {
            commit = $1
            commit_msg = $3
            file = $4

            if (commit != prev_commit) {
                if (prev_commit != "") print ""
                print "\n" commit_msg ":"
                prev_commit = commit
            }
            print "  • " file
        }
    '

    echo ""
    echo "=========================================================="
    echo "Creating fixup commits..."
    echo ""

    local prev_hash=""
    local files=()
    local skipped=()

    # Process each line, grouping files by commit hash
    while IFS='|' read -r short_hash full_hash commit_msg file; do
        if [[ "$short_hash" == "UPSTREAM" || "$short_hash" == "NEW" ]]; then
            skipped+=("$file")
            continue
        fi

        # When we hit a new commit group, flush the previous group
        if [[ -n "$prev_hash" && "$full_hash" != "$prev_hash" ]]; then
            git add -- "${files[@]}"
            git commit --fixup="$prev_hash"
            files=()
        fi

        prev_hash="$full_hash"
        files+=("$file")
    done <<< "$data"

    # Flush the last group
    if [[ -n "$prev_hash" && ${#files[@]} -gt 0 ]]; then
        git add -- "${files[@]}"
        git commit --fixup="$prev_hash"
    fi

    if [[ ${#skipped[@]} -gt 0 ]]; then
        echo ""
        echo "Skipped (upstream/new - no branch commit to fixup):"
        for f in "${skipped[@]}"; do
            echo "  • $f"
        done
    fi
}

# Show last run time and result for user systemd services
systemd-status() {
  systemctl --user list-timers --all --no-pager 2>/dev/null
}

# Minimal command-not-found handler.
# Fedora's PackageKit-command-not-found ships /etc/profile.d/PackageKit.sh,
# which registers a handler that shells out to /usr/libexec/pk-command-not-found
# and queries PackageKit over D-Bus to suggest "did you mean to install X?".
# That round-trip hangs the terminal for seconds on every typo.
# Fix: `sudo dnf remove PackageKit-command-not-found` and define our own
# no-op handler so zsh still prints a message instead of silent return 127.
command_not_found_handler() {
  print -u2 "zsh: command not found: $1"
  return 127
}
